load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")

package_metadata(
    name = "package_metadata",
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "LICENSE",
)

bool_flag(
    name = "enable_header_generation",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# The body-use cutoff's tool, an ifc_digest_tool target (see //d:ifc_digest.bzl). Off by default.
label_flag(
    name = "ifc_digest",
    build_setting_default = "//d/private/tools/ifc_digest:off",
    visibility = ["//visibility:public"],
)
